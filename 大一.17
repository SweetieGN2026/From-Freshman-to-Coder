#include <stdio.h>
int main() {
    int n;
    printf("请输入：");
    scanf("%d", &n);
    printf("%d = ", n);
    int isprime = 1;
    for (int i = 2; i <= n; i++) {//1开始没有意义
        while (n % i == 0) {
            if (!isprime) {
                printf("*");
            }
            printf("%d", i);
            isprime = 0;
            n /= i;//接着走
        }
    }
    printf("\n");
    return 0;
}
//及其复杂的冗余
