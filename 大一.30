#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;
Node* createNode(int val) {
    Node *newNode = (Node *)malloc(sizeof(Node));
    if (newNode == NULL) {
        printf("失败！\n");
        return 0;
    }
    newNode->data = val;
    newNode->next = NULL;
    return newNode;
}
Node* append(Node *head, int val) {
    Node *newNode = createNode(val);
    if (head == NULL) {
    }
    Node *p = head;
    while (p->next != NULL) {
        p = p->next;
    }
    p->next = newNode;
    return head;
}
void printList(Node *head) {
    Node *p = head;
    printf("链表内容：");
    while (p != NULL) {
        printf("%d -> ", p->data);
        p = p->next;
    }
    printf("NULL\n");
}

void freeList(Node *head) {
    Node *p;
    while (p != NULL) {
        p = head;
        head = head->next;
        free(p);
    }
}

int main() {
    Node *head = NULL;

    head = append(head, 1);
    head = append(head, 2);
    head = append(head, 3);

    printList(head);

    freeList(head);
    return 0;
}
//重温基础链表
