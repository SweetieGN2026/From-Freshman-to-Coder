#include <stdio.h>
#include <math.h>

int main()
{
    int s, f, m;
    for(s=0; s<=6; s++){
        for(f=0; f<60; f++){
            for(m=0; m<60; m++){
                if(s==0&&f==0&&m==0)
                    continue;

                double h = s*30 + f*0.5 + m/120.0;
                double mi = f*6 + m*0.1;
                double se = m*6.0;

                double A = fabs(h - mi);
                if(A>180)
                    A=360-A;

                double B = fabs(mi - se);
                if(B>180)
                    B=360-B;
                if(A==2*B){
                    if(fabs(A - 2*B) < 1e-6){
                        printf("%d %d %d",s,f,m);

                    }
                }
            }
        }
    }
    return 0;
}
/*在 12 小时制钟表中，有时针、分针、秒针匀速转动。
记：
时针与分针的最小夹角为 A（0 ≤ A ≤ 180）
分针与秒针的最小夹角为 B（0 ≤ B ≤ 180）
在 s 时 f 分 m 秒 满足：
A = 2B
0 ≤ s ≤ 6，0 ≤ f < 60，0 ≤ m < 60
不是 0 时 0 分 0 秒
求一组满足条件的整数 s, f, m。
*/
/*枚举所有时间
三层循环遍历：时 s (0~6)、分 f (0~59)、秒 m (0~59)。
计算三个指针角度
时针：h = s*30 + f*0.5 + m/120.0
分针：mi = f*6 + m*0.1
秒针：se = m*6
求最小夹角
角度差大于 180° 时，用 360 减去它，得到小夹角。
判断条件 A = 2B
满足就输出答案。*/
