#include <iostream>
#include <cstdlib>
using namespace std;

// 定义链表元素类型，方便统一修改
typedef int ElemType;

// 单链表结点结构体定义，王道标准写法，LinkList等价LNode*
typedef struct LNode {
    ElemType data;        // 数据域，存放结点数值
    struct LNode *next;   // 指针域，指向下一个单链表结点
} LNode, *LinkList;

/**
 * @brief 初始化【带头结点】单链表
 * @param L 链表头指针引用，函数内修改外部头结点
 * @return 内存分配成功返回true，失败返回false
 */
bool InitList(LinkList& L) {
    // 分配头结点内存，头结点不存储有效数据
    L = (LNode*)malloc(sizeof(LNode));
    if (L == NULL)
        return false;
    L->next = NULL; // 初始链表无数据结点，头结点后继置空
    return true;
}

/**
 * @brief 初始化【不带头结点】单链表
 * @param L 链表头指针引用
 * @return 固定返回true，直接置空代表空表
 * @note 本文件其余操作函数均只兼容带头结点链表，两套初始化不可混用
 */
bool InitList2(LinkList& L) {
    L = NULL;
    return true;
}

/**
 * @brief 计算带头结点单链表长度（有效数据结点个数）
 * @param L 链表头指针，只读不修改
 * @return 链表数据结点总个数
 */
int Length(LinkList L) {
    LNode* p = L; // p遍历指针，从头结点开始
    int len = 0;  // 计数器统计结点数量
    // 循环走到最后一个数据结点，停止计数
    while (p->next != NULL) {
        p = p->next;
        len++;
    }
    return len;
}

/**
 * @brief 按位查找：返回第i个位置的数据结点指针
 * @param L 链表头指针
 * @param i 目标位序，数据结点从1开始计数
 * @return 找到返回对应结点指针；i非法/超出表长返回NULL
 */
LNode* GetElem(LinkList L, int i) {
    LNode* p = L;
    // 位序合法性校验：不存在第0位、不能超过链表长度
    if (i < 1 || i > Length(L))
        return NULL;
    int j = 0; // 遍历计数器，记录当前走到第几个结点
    // 循环向后遍历i次，到达第i个数据结点
    while (p != NULL && j < i) {
        p = p->next;
        j++;
    }
    return p;
}

/**
 * @brief 按值查找：找到第一个值等于e的结点
 * @param L 链表头指针
 * @param e 待查找目标元素
 * @return 找到返回结点指针；遍历结束无匹配返回NULL
 */
LNode* LocateElem(LinkList L, ElemType e) {
    LNode* p = L;
    // p!=NULL短路保护，不会访问空指针成员
    while (p != NULL && p->data != e) {
        p = p->next;
    }
    return p;
}

/**
 * @brief 按位插入：在第i个位置插入元素e
 * @param L 链表头指针引用，可能修改链表结构
 * @param i 插入位序，合法范围1<=i<=Length(L)+1（可插表尾）
 * @param e 需要插入的数值
 * @return 插入成功true；位序非法/分配内存失败false
 */
bool InsertElem(LinkList& L, int i, ElemType e) {
    LNode* p = L;
    int j = 0;
    // 校验插入位序是否合法
    if (i < 1 || i > Length(L) + 1)
        return false;
    // 循环走到第i个结点的前驱结点
    while (p != NULL && j < i - 1) {
        p = p->next;
        j++;
    }
    if (p == NULL)
        return false;
    // 新建待插入结点s
    LNode* s = (LNode*)malloc(sizeof(LNode));
    if (s == NULL)
        return false;
    s->data = e;
    // 头插标准两步：新结点指向原后继，前驱指向新结点
    s->next = p->next;
    p->next = s;
    return true;
}

/**
 * @brief 按位删除：删除第i个位置的结点，并用e带出被删数值
 * @param L 链表头指针引用
 * @param i 删除目标位序，1<=i<=Length(L)
 * @param e 引用参数，接收被删除结点的数据
 * @return 删除成功true；位序非法/无对应结点false
 */
bool DeletElem(LinkList& L, int i, ElemType& e) {
    LNode* p = L;
    int j = 0;
    // 校验删除位序合法性
    if (i < 1 || i > Length(L))
        return false;
    // 遍历找到第i个结点的前驱
    while (p != NULL && j < i - 1) {
        p = p->next;
        j++;
    }
    // 前驱为空 / 待删结点不存在，删除失败
    if (p == NULL || p->next == NULL) {
        return false;
    }
    LNode* q = p->next; // q保存待删除结点地址
    e = q->data;        // 取出被删结点的值
    p->next = q->next;  // 链表跳过待删结点
    free(q);            // 释放被删结点堆内存，防止泄漏
    return true;
}

/**
 * @brief 头插法批量建立带头结点单链表
 * @param L 头指针引用，函数内部重新创建链表覆盖外部L
 * @return 返回建好的链表头指针，终止标记输入100结束建表
 * @note 输入顺序逆序存储，例输入1 2 100，链表存储2→1
 */
LinkList HeadInsert(LinkList& L) {
    int x;
    LNode* s;
    // 函数内部新建头结点，覆盖外部传入指针
    L = (LNode*)malloc(sizeof(LNode));
    if (L == NULL)
        return NULL;
    L->next = NULL;
    // 先读取第一个输入值
    scanf("%d", &x);
    // 输入100代表结束建表
    while (x != 100) {
        s = (LNode*)malloc(sizeof(LNode));
        if (s == NULL)
            return NULL;
        s->data = x;
        // 头插两步：新结点指向头结点后第一个结点，头结点指向新结点
        s->next = L->next;
        L->next = s;
        scanf("%d", &x);
    }
    return L;
}

/**
 * @brief 尾插法正向建立带头结点单链表
 * @param L 头指针引用，函数内部重新分配头结点覆盖外部L
 * @return 返回建好链表头指针，输入100终止建表
 * @note 输入顺序与链表存储顺序一致，符合正常阅读习惯
 */
LinkList TailInsert(LinkList& L) {
    // 分配链表头结点
    L = (LNode*)malloc(sizeof(LNode));
    if (L == NULL)
        return NULL;
    int x;
    LNode *s, *p = L; // p为尾指针，初始指向头结点，永远记录链表最后一位

    scanf("%d", &x);
    while (x != 100) {
        s = (LNode*)malloc(sizeof(LNode));
        if (s == NULL)
            return NULL;
        s->data = x;
        p->next = s; // 尾指针后继接上新建结点
        p = s;       // 尾指针后移，更新为新表尾
        scanf("%d", &x);
    }
    p->next = NULL; // 链表尾结点后继置空，防止遍历野指针
    return L;
}

/**
 * @brief 双向链表结点结构体定义（王道P40拓展内容）
 */
typedef struct DNode {
    ElemType data;        // 数据域
    struct DNode *prior;  // 前驱指针，指向前一个结点
    struct DNode *next;   // 后继指针，指向下一个结点
} DNode, *DLinkList;

