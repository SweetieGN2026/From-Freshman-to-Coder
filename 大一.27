#include <stdio.h>
int main() {
    int n, i, count = 0, num = 0;
    int arr[100];
    printf("输入人数n：");
    scanf("%d", &n);
    for (i = 0; i < n; i++) {
        arr[i] = 1;// 1是标记 还在这个圈里面  o是在外面排除了
    }
    for (i = 0; count < n - 1; i = (i + 1) % n) {
        if (arr[i] == 1) {
            num++;
            // 报到3的人出列
            if (num == 3) {
                arr[i] = 0;
                count++;
                num = 0;
            }
        }
    }
    for (i = 0; i < n; i++) {
        if (arr[i] == 1) {
            printf("最后留下的是原来第%d号的那位\n", i + 1);
            break;
        }
    }//这个能得出来是因为
    // 虽然原来已经改变  但是 还有一个还存在 然后在正常计数排序是一样的

    return 0;
}
//约瑟夫环问题
