#include <stdio.h>
#include <string.h>
typedef struct {
    int id;         // 学号
    char name[20];  // 姓名
    float score;    // 成绩
} Student;

void input(Student people[], int n) {
    int i;
    for (i = 0; i < n; i++) {
        printf("输入第%d个学生的信息（学号 姓名 成绩）：\n", i + 1);
        scanf("%d %s %f", &people[i].id, people[i].name, &people[i].score);
    }
}
void output(Student people[], int n) {
    int i;
    printf("\n===== 学生信息列表 =====\n");
    printf("学号\t姓名\t成绩\n");
    for (i = 0; i < n; i++) {
        printf("%d\t%s\t%.2f\n", people[i].id, people[i].name, people[i].score);
    }
}

int main() {
    Student students[5];

    input(students, 5);

    output(students, 5);

    return 0;
}//编写 input() 和 output() 两个函数
