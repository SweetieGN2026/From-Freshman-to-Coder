#include <stdio.h>
#include <string.h>

int main() {
    char am[20];
    scanf("%s", &am);
    int len = strlen(am);
    int cont=1;
    int sum=0;
    for(int i=0;i<len;i++) {
        if(am[i] != '-'){
            sum+=(am[i]-'0')*cont;
            cont++;
            if (cont > 9)
                break;
        }
    }
    int mod = sum % 11;
    char right;
    if (mod == 10)
        right = 'X';
    else
        right = mod + '0';

    if (am[len-1] == right) {
        printf("Right\n");
    } else {
        am[len-1] = right;
        printf("%s\n", am);
    }
    return 0;
}
/*给你一个 ISBN 码，比如：0-670-82162-4
把里面的 '-' 去掉，只取前 9 个数字
按顺序乘 1、2、3…9 后求和
总和 mod 11，得到识别码
余数 = 10 → 识别码是 X
其他 → 识别码是数字
对比你输入的最后一位
对 → 输出 Right
错 → 输出改正后的正确 ISBN*/
