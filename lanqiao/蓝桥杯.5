#include <stdio.h>
#include <stdlib.h>

typedef  struct node {
    int data;
    struct  node *next;
}node;
node *head = NULL;
void init() {
    head=(node*)malloc(sizeof(node));
    head->data=1;
    node  *tail = head;
    for (int i = 2; i <= 10; i++) {
        node *new = (node*)malloc(sizeof(node));
        new->data = i;
        tail->next = new;
        tail = new;
    }
    tail->next = head;
}

void move(int x) {
    node *p = head, *pre = NULL;
    while (p->data != x) {
        pre = p;
        p = p->next;
    }

    if (pre == NULL)
        return;


    pre->next = p->next;//这个写法一定要 想想拉手
    p->next = head;


    node *tail = head;
    while (tail->next != head) {
        tail = tail->next;
    }
    tail->next = p;
    head = p;
}
void print() {
    node *p = head;
    for (int i = 0; i < 10; i++) {
        printf("%d ", p->data);
        p = p->next;
    }
    printf("\n");
}

int main() {
    init();
    int M, x;
    scanf("%d", &M);
    while (M--) {
        scanf("%d", &x);
        move(x);
        print();
    }
    return 0;
}
