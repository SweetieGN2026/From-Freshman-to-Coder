#include <stdio.h>
#define   MAXN 100005
long long s[MAXN];    // 前缀
long long cnt[MAXN];  // 余数

int main() {
    int n, k;
    scanf("%d%d", &n, &k);

    s[0] = 0;
    for (int i = 1; i <= n; i++) {
        int x;
        scanf("%d", &x);
        s[i] = s[i-1] + x;
    }
    for (int i = 0; i <= n; i++) {
        int r = (s[i] % k + k) % k;
        cnt[r]++;//对应的加  取余已经是分类好了
    }
    long long ans = 0;
    for (int r = 0; r < k; r++) {
        ans += cnt[r] * (cnt[r] - 1) / 2;
    }
    printf("%lld\n", ans);
    return 0;
}
/*给定一个数组，问：有多少个连续子段的和是 K 的倍数。
求前缀和 s[i]
对每个 s[i] 求 % k 的余数
统计每个余数出现多少次，存在 cnt[] 里
对每个余数 r，算组合数：
cnt[r] * (cnt[r]-1) / 2
全部加起来就是答案*/#include <stdio.h>
#define   MAXN 100005
long long s[MAXN];    // 前缀
long long cnt[MAXN];  // 余数

int main() {
    int n, k;
    scanf("%d%d", &n, &k);

    s[0] = 0;
    for (int i = 1; i <= n; i++) {
        int x;
        scanf("%d", &x);
        s[i] = s[i-1] + x;
    }
    for (int i = 0; i <= n; i++) {
        int r = (s[i] % k + k) % k;
        cnt[r]++;//对应的加  取余已经是分类好了
    }
    long long ans = 0;
    for (int r = 0; r < k; r++) {
        ans += cnt[r] * (cnt[r] - 1) / 2;
    }
    printf("%lld\n", ans);
    return 0;
}
