#include <stdio.h>
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}
int main() {
    int arr[100], n, i;
    int max_idx = 0, min_idx = 0;

    printf("输入数组长度：");
    scanf("%d", &n);
    printf("输入数组元素：");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    for (i = 1; i < n; i++) {
        if (arr[i] > arr[max_idx])
            max_idx = i;
        if (arr[i] < arr[min_idx])
            min_idx = i;
    }
    if (max_idx != 0) {
        swap(&arr[0], &arr[max_idx]);
        // 同步更新最小值下标  因为最大值和最小值可能都在第一个位置 arr [0] 上
        if (min_idx == 0)
            min_idx = max_idx;
    }

    if (min_idx != n - 1) {
        swap(&arr[n - 1], &arr[min_idx]);
    }
    //因为 前面已经排除了  在首位的可能性
    printf("交换后：");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
//数组最大元素与首元素交换、最小元素与尾元素交换
