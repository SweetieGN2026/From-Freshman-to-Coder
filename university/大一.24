#include <stdio.h>
char stack[100];
int top = -1;   //标记的第一个影响着后面的top++还是++top  同理还有--
void push(char c) {
    stack[++top] = c;
}
char pop() {
    return stack[top--];
}
int main() {
    for (int i = 0; i < 5; i++) {
        char c;
        scanf(" %c", &c);
        push(c);
    }
    for (int i = 0; i < 5; i++) {
        printf("%c", pop());
    }

    return 0;
}
//天然的反向输出
