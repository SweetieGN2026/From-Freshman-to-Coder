#include <stdio.h>

double sum_os(int n) {
    double sum = 0.0;
    for (int i = 2; i <= n; i += 2) {
        sum += 1.0 / i;
    }
    return sum;
}

double sum_js(int n) {
    double sum = 0.0;
    for (int i = 1; i <= n; i += 2) {
        sum += 1.0 / i;
    }
    return sum;
}

typedef double (*find)(int);/* 前面 double = 函数返回值
   后面 int = 函数参数 */


int main() {
    int n;
    printf("请输入n：");
    scanf("%d", &n);
    find hp;

    if (n % 2 == 0) {
        hp = sum_os;
    } else {
        hp = sum_js;
    }

    double result = hp(n);
    printf("结果：%.8f\n", result);

    return 0;
}
