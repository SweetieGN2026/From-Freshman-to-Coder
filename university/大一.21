#include <stdio.h>
int main()
{
    int a[10] = {1, 3, 5, 7, 9};
    int n = 5;
    int x;
    int stack[20];
    int top = -1;
    int i;

    printf("请输入：");
    scanf("%d", &x);
    for (i = 0; i < n && a[i] < x; i++) {
        stack[++top] = a[i];
    }
    stack[++top] = x;
    for (; i < n; i++) {
        stack[++top] = a[i];
    }
    printf("插入后：");
    for (i = 0; i <= top; i++) {
        printf("%d ", stack[i]);
    }

    return 0;
}
//栈的排序  
