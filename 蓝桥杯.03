
#include<stdio.h>
#include<string.h>
int main() {
    char s1[100],s2[100];
    scanf("%s", s1);
    scanf("%s", s2);

    int len1,len2;
    len1=strlen(s1);
    len2=strlen(s2);

    int maxLen = 0;
    int endlen = 0;

    for (int i = 0; i < len1; i++) {
        for (int j = 0; j < len2; j++) {
            int n= 0;
            while (i + n < len1 && j + n < len2 && s1[i + n] == s2[j + n]) {
                n++;
            }
            if (n > maxLen) {
                maxLen = n;
                endlen = i;
            }
        }
    }

    for (int i = endlen; i < endlen + maxLen; i++) {
        printf("%c", s1[i]);
    }

    return 0;

}
/*实现一个算法查找两个字符串最长的公共子字符串。子字符串的介绍如下：

子字符串是指字符串中任意个连续的字符组成的子序列。
输入描述
输入两行，每行一串字符串，长度均不超过 1000。*/
